{
    "cors": {
        "enabled": true,
        "policies": {
            "mcp": {
                "headers": "Content-Type | MCP-Protocol-Version | Mcp-Session-Id",
                "methods": "POST",
                "origins": "*"
            }
        }
    },
    "kestrel": {
        "endpoints": {
            "http": {
                "url": "http://0.0.0.0:9001"
            }
        }
    },
    "logging": {
        "deepSight": {
            "appName": "DeepSight MCP Server",
            "appVersion": "10.2608.0",
            "url": "http://deepsight.tokiota.com:9000/api/v1/00000000-0000-0000-0000-000000000000"
        },
        "logLevel": {
            "console": "debug",
            "deepSight": "debug",
            "default": "debug",
            "microsoft": "warning"
        }
    },
    "telemetry": {
        "deepSight": {
            "appName": "DeepSight MCP Server",
            "appVersion": "10.2608.0",
            "url": "http://deepsight.tokiota.com:9000/api/v1/00000000-0000-0000-0000-000000000000"
        }
    }
}
